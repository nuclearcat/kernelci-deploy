{% macro proxy_to(port) -%}
proxy_pass http://127.0.0.1:{{ port }};
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host $host;
proxy_set_header X-Forwarded-Port $server_port;
proxy_http_version 1.1;
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection "upgrade";
proxy_connect_timeout 60s;
proxy_send_timeout 60s;
proxy_read_timeout 60s;
{%- endmacro %}
# Managed by Ansible.  The Dashboard application itself is deployed by the
# kernelci/dashboard GitHub Actions workflows.
server {
    listen 80;
    listen [::]:80;
    server_name {{ dashboard_production_domains | join(' ') }};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
{% if dashboard_tls_available | bool %}
        return 301 https://$host$request_uri;
{% else %}
{{ proxy_to(dashboard_production_upstream_port) | indent(8, true) }}
{% endif %}
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name {{ dashboard_staging_domain }};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
{% if dashboard_tls_available | bool %}
        return 301 https://$host$request_uri;
{% else %}
{{ proxy_to(dashboard_staging_upstream_port) | indent(8, true) }}
{% endif %}
    }
}

{% if dashboard_tls_available | bool %}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ dashboard_production_domains | join(' ') }};

    ssl_certificate /etc/letsencrypt/live/{{ dashboard_certificate_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ dashboard_certificate_name }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = /robots.txt {
        add_header Content-Type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    if ($http_user_agent ~* (bot|crawler|spider|slurp|baidu|yandex|wget|curl)) {
        return 403;
    }

    if ($dashboard_blocklisted) {
        return 403 "Access denied: this network was blocked because of automated abusive traffic.\n";
    }

    location / {
{{ proxy_to(dashboard_production_upstream_port) | indent(8, true) }}
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ dashboard_staging_domain }};

    ssl_certificate /etc/letsencrypt/live/{{ dashboard_certificate_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ dashboard_certificate_name }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = /robots.txt {
        add_header Content-Type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    if ($http_user_agent ~* (bot|crawler|spider|slurp|baidu|yandex|wget|curl)) {
        return 403;
    }

    if ($dashboard_blocklisted) {
        return 403 "Access denied: this network was blocked because of automated abusive traffic.\n";
    }

    location / {
{{ proxy_to(dashboard_staging_upstream_port) | indent(8, true) }}
    }
}
{% endif %}
